# Server-only secret used by api/instagram-feed.js — do NOT prefix with VITE_
# (VITE_-prefixed vars are bundled into client JS and would leak the token).
INSTAGRAM_ACCESS_TOKEN=

# Kakao Maps JavaScript key — this one IS meant to ship to the client
# (Kakao restricts it by registered domain in the Kakao Developers console).
VITE_KAKAO_MAP_KEY=
